# Memory Palace OS Environment Configuration
# Copy to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change_me_in_production
APP_ENV=prod

# ─── WeChat Work (企微) ───────────────────────────────────────────────────────
WECHAT_CORP_ID=your_corp_id
WECHAT_AGENT_ID=your_agent_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_TOKEN=your_token
WECHAT_ENCODING_AES_KEY=your_43_char_aes_key_base64

# Optional outbound notification channels
SMS_PROVIDER=
SMS_API_KEY=
SMS_SIGN_NAME=
VOICE_PROVIDER=
VOICE_API_KEY=
ALERT_PHONES=

# ─── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
MEMORY_PALACE_SECRETS_VOLUME=memory-palace-secrets
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-flash
OPENAI_TIMEOUT=30

# ─── Local vector search ──────────────────────────────────────────────────────
# Run `python scripts/prepare_scenic_agent_runtime.py --model-cache-dir <absolute path> --reranker-dir <absolute path>` first.
# Docker mounts this directory read-only; the model is never baked into the image.
BGE_M3_CACHE_DIR=D:/memory-palace-models/huggingface
BGE_M3_MODEL_PATH=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# CPU torch on some hosts aborts with a native access violation when it uses every
# logical core; the adapter bounds OpenMP/MKL threads and mirrors them onto torch.
EMBEDDING_CPU_THREADS=4
PGVECTOR_INDEX_NAME=knowledge_vectors_bge_m3_v1

# ─── Reverse proxy / protected preparation entry ──────────────────────────────
# The app sits behind nginx in Docker, so it must trust the forwarding headers to see the
# real client address (audit logs and the protected run-preparation entry depend on it).
TRUST_PROXY_HEADERS=true
# Only the listed hosts may drive the simulation clock through /operations/scenic/commands.
# Keep loopback when no proxy is in front; add the ingress host address for container runs.
SCENIC_PREP_ALLOWED_HOSTS=127.0.0.1,::1,localhost,testclient

# ─── Local demo entry point ───────────────────────────────────────────────────
# The demo is served by nginx on this host port. 8080 is often taken by other local
# projects, so the scenic demo owns 8090.
HTTP_PORT=8090

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=memory_palace
POSTGRES_USER=mp_user
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_URL=postgresql://mp_user:replace_with_database_password@postgres:5432/memory_palace

# ─── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
USE_REDIS=true

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
METRICS_ENABLED=true

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_12_character_password
ADMIN_DISPLAY_NAME=系统管理员
# UAT employee credentials are stored in the external Docker secret volume.
# Run scripts/set_uat_employee_secret.ps1 once; do not commit the password here.
UAT_EMPLOYEE_PASSWORD_FILE=/run/memory-palace-secrets/uat_employee_password
SCENIC_ACCOUNT_PASSWORD_FILE=/run/memory-palace-secrets/scenic_account_password
DEFAULT_VENUE_ID=venue-hq
DEFAULT_VENUE_NAME=示范景区运营中心
MEMORY_PALACE_JWT_SECRET=replace_with_at_least_32_random_characters
MEMORY_PALACE_ACCESS_TOKEN_TTL=1800
MEMORY_PALACE_REFRESH_TOKEN_TTL=604800
# ─── Scenic Agent runtime profiles ───────────────────────────────────────────
# Default `docker compose up` runs only app/postgres/redis/nginx.
# Enable TEI with: --profile tei-embedding --profile tei-reranker
TEI_EMBEDDING_PORT=18000
TEI_RERANKER_PORT=18001
TEI_RERANKER_MODEL_DIR=D:/memory-palace-models/tei/bge-reranker-base-onnx
# Enable Hatchet with: --profile agent-runtime
HATCHET_HTTP_PORT=8091
HATCHET_SERVER_URL=http://localhost:8091
HATCHET_POSTGRES_DB=hatchet
HATCHET_POSTGRES_USER=hatchet
HATCHET_POSTGRES_PASSWORD=replace_with_hatchet_database_password
# Enable Jaeger with: --profile tracing
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
# Keep empty for the default profile. Set these only when the corresponding
# optional services are running so /ready reports their true state.
SCENIC_TEI_EMBEDDING_HEALTH_URL=http://tei-embedding:80/health
SCENIC_TEI_EMBEDDING_URL=
SCENIC_TEI_RERANKER_URL=
TEI_EMBEDDING_TIMEOUT=20
TEI_RERANKER_TIMEOUT=20
TEI_MAX_CLIENT_BATCH_SIZE=16
SCENIC_TEI_RERANKER_HEALTH_URL=
HATCHET_HEALTH_URL=
JAEGER_HEALTH_URL=
SCENIC_AGENT_DAILY_TOKEN_LIMIT=20000000
SCENIC_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
SCENIC_AGENT_CIRCUIT_RECOVERY_SECONDS=60
JAEGER_UI_URL=http://localhost:16686
SCENIC_EVAL_MODEL=deepseek-flash
