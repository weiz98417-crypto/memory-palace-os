{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {"title": "经验资产 · 来源、审核、发布与使用", "locale": "zh-CN", "quality_profile": "showcase"},
  "lanes": [
    {"id": "capture", "label": "来源与草稿"},
    {"id": "review", "label": "人工治理"},
    {"id": "reuse", "label": "授权复用"}
  ],
  "nodes": [
    {"id": "source", "lane": "capture", "col": 0, "type": "database", "label": "访谈 / 关闭事件", "sublabel": "可追溯原始证据", "width": 130},
    {"id": "draft", "lane": "capture", "col": 1, "type": "database", "label": "DRAFT", "sublabel": "经验卡草稿"},
    {"id": "confirmed", "lane": "review", "col": 2, "type": "security", "label": "EXPERT_CONFIRMED", "sublabel": "专家确权", "width": 150},
    {"id": "in_review", "lane": "review", "col": 3, "type": "security", "label": "IN_REVIEW", "sublabel": "内容审核"},
    {"id": "published", "lane": "reuse", "col": 3, "type": "database", "label": "PUBLISHED", "sublabel": "授权与向量索引"},
    {"id": "retrieval", "lane": "reuse", "col": 4, "type": "backend", "label": "授权检索", "sublabel": "实时来源核验"},
    {"id": "usage", "lane": "reuse", "col": 5, "type": "database", "label": "使用与反馈", "sublabel": "experience_usage_logs"},
    {"id": "deprecated", "lane": "review", "col": 4, "type": "database", "label": "DEPRECATED", "sublabel": "不再作为发布来源"}
  ],
  "mainPath": ["source", "draft", "confirmed", "in_review", "published", "retrieval", "usage"],
  "edges": [
    {"from": "source", "to": "draft", "label": "萃取并校验", "role": "main"},
    {"from": "draft", "to": "confirmed", "label": "专家确认", "role": "main"},
    {"from": "confirmed", "to": "in_review", "label": "提交审核", "role": "main"},
    {"from": "in_review", "to": "published", "label": "审核通过", "role": "main"},
    {"from": "published", "to": "retrieval", "label": "授权可用", "role": "main"},
    {"from": "retrieval", "to": "usage", "label": "引用留痕", "role": "main"},
    {"from": "in_review", "to": "draft", "label": "驳回返工"},
    {"from": "published", "to": "deprecated", "label": "废弃"}
  ],
  "cards": [
    {"dot": "cyan", "title": "数据账本", "items": ["访谈及轮次、候选及尝试、经验卡及版本、授权、审核与 experience_usage_logs 分别留痕。", "经验卡发布后建索引；后续检索仍检查授权、状态与来源版本。"]},
    {"dot": "amber", "title": "状态与边界", "items": ["IN_REVIEW 可驳回至 DRAFT；PUBLISHED 可转为 DEPRECATED。", "关闭事件会写 CASE 向量，但当前演示场景的固定文案限制了其通用性。"]}
  ]
}
